{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: FireSim.Api Debug",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/backend/src/FireSim.Api/FireSim.Api.csproj"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "크롬에서 React 디버깅",
            "url": "http://localhost:5173",
            "webRoot": "${workspaceFolder}/frontend",
            "skipFiles": [
                "${workspaceFolder}/frontend/node_modules/**/*.js",
                "<node_internals>/**/*.js"
            ]
        }
    ]
}